# OpenAI (Whisper STT, chat agent, TTS)
OPENAI_API_KEY=sk-...

# WalletConnect Cloud project id — https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id

# Optional custom RPCs (defaults use public endpoints)
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ROOTSTOCK_TESTNET_RPC_URL=https://public-node.testnet.rsk.co

# Optional 0x API key for swap quotes (Ethereum/Base Sepolia)
ZEROX_API_KEY=

# Session soft spend cap in native units (UI hint only)
NEXT_PUBLIC_SESSION_SPEND_CAP=0.05
