# Prefer Google AI Studio: https://aistudio.google.com/apikey
# Required for Electron tray mic (Gemini STT). Typing/local actions work without it.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional OpenAI fallback — real platform.openai.com keys only (not Cursor sk-AQ.… keys)
# OPENAI_API_KEY=

# Local desktop agent (apps/desktop-agent)
NEXT_PUBLIC_DESKTOP_AGENT_URL=http://127.0.0.1:3847
