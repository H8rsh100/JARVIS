# Prefer Google AI Studio: https://aistudio.google.com/apikey
# Required for Electron tray mic (Gemini STT). Typing/local actions work without it.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional OpenAI fallback — real platform.openai.com keys only (not Cursor sk-AQ.… keys)
# OPENAI_API_KEY=

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ROOTSTOCK_TESTNET_RPC_URL=https://public-node.testnet.rsk.co
ZEROX_API_KEY=
NEXT_PUBLIC_SESSION_SPEND_CAP=0.05

# Local desktop agent (apps/desktop-agent)
NEXT_PUBLIC_DESKTOP_AGENT_URL=http://127.0.0.1:3847
